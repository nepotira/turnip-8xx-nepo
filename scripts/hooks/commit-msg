#!/usr/bin/env bash
# Valida a 1ª linha da mensagem: Conventional Commits. Ative: git config core.hooksPath scripts/hooks
msg="$(head -n1 "$1")"
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'
case "$msg" in Merge*|Revert*|fixup!*|squash!*) exit 0;; esac
if ! echo "$msg" | grep -Eq "$re"; then
  echo "Mensagem inválida: '$msg'"
  echo "Use: tipo(escopo)!: descrição (até 72 caracteres). Tipos: feat fix docs style refactor perf test build ci chore revert"
  exit 1
fi
