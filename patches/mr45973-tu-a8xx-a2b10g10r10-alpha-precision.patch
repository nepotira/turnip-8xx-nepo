+/* Driconf <device> matches the kernel with kernel_driver="kgsl|msm|virtio",
+ * the GPU generation with device_version_regexp="^8$", and the GPU with
+ * device="0x44050a31", the low 32 bits of the chip_id without the fuse id.
+ */
+static void
+tu_init_dri_options(struct tu_physical_device *device)
+{
+   struct tu_instance *instance = device->instance;
+
+   char chip_id[11];
+   snprintf(chip_id, sizeof(chip_id), "0x%08x",
+            (uint32_t) device->dev_id.chip_id);
+
+   driConfigFileParseParams params = {
+      .driverName = "turnip",
+      .kernelDriverName = instance->knl->name,
+      .deviceName = chip_id,
+      .deviceVersion = fd_dev_gen(&device->dev_id),
+      .applicationName = instance->vk.app_info.app_name,
+      .applicationVersion = instance->vk.app_info.app_version,
+      .engineName = instance->vk.app_info.engine_name,
+      .engineVersion = instance->vk.app_info.engine_version,
+      .logNonDefaultOptions = TU_DEBUG(STARTUP),
+   };
+
+   turnip_parse_dri_options(&device->drirc, &params);
+
+   if (TU_DEBUG(NO_CONCURRENT_BINNING))
+      device->drirc.perf.allow_concurrent_binning = false;
+   if (TU_DEBUG(FORCE_CONCURRENT_BINNING))
+      device->drirc.perf.allow_concurrent_binning = true;
+}
