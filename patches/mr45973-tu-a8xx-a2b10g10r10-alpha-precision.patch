diff --git a/src/freedreno/vulkan/tu_nir_a2_alpha_workaround.h b/src/freedreno/vulkan/tu_nir_a2_alpha_workaround.h
new file mode 100644
index 000000000000..83ff8d5476fb
--- /dev/null
+++ b/src/freedreno/vulkan/tu_nir_a2_alpha_workaround.h
@@ -0,0 +1,380 @@
+/*
+ * Copyright © 2026 Igalia S.L.
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef TU_NIR_A2_ALPHA_WORKAROUND_H
+#define TU_NIR_A2_ALPHA_WORKAROUND_H
+
+#include "nir/nir_builder.h"
+
+#include "tu_shader.h"
+
+/* KGSL does not set b20 of TPL1_DBG_ECO_CNTL and b25 of TPL1_DBG_ECO_CNTL1
+ * on A8XX. Without them the TP converts the 2-bit alpha of
+ * 10_10_10_2_UNORM with fp16 precision: an alpha of 1/3 is returned as
+ * `fp16(1/3)` and 2/3 as `2 * fp16(1/3)`, both too low by a factor of
+ * `(1 - 2^-12)`. 0 and 1 are returned exactly.
+ *
+ * Games that decode a material ID for deferred rendering by reading A2
+ * would get a wrong result without the workaround. Patterns seen in the
+ * games:
+ *
+ * ```
+ * vec4 gb = texelFetch(gbuffer, coord, 0);   // A2B10G10R10_UNORM
+ * bool flag = gb.a > 0.666666;
+ * roughness = flag ? min(other.a, 0.08) : fract(...) * 0.090667;
+ * ```
+ *
+ * ```
+ * vec4 gb = texelFetch(gbuffer, coord, 0);
+ * int id = int(gb.a * 3.0);
+ * ```
+ *
+ * We match trunc(fmul(alpha, const)) and comparisons of alpha with a constant
+ * where the error changes the result, and multiply alpha by 4096 / 4095 when
+ * the descriptor marks the alpha channel as A2, see FDL6_A2_MASK_DWORD.
+ * Non-identity view swizzles that move the alpha to another channel are not
+ * handled.
+ */
+
+/* fp16(1/3), which the TP returns for an alpha of 1/3. */
+#define A2_ALPHA_HW_THIRD (1365.0f / 4096.0f)
+
+/* The source src of alu reads the alpha result. */
+struct a2_alpha_site {
+   nir_alu_instr *alu;
+   unsigned src;
+   nir_scalar result;
+};
+
+static inline bool
+is_a2_alpha_image_format(nir_intrinsic_instr *intr)
+{
+   enum pipe_format format = nir_intrinsic_format(intr);
+   if (intr->intrinsic == nir_intrinsic_image_deref_load) {
+      nir_variable *var = nir_intrinsic_get_var(intr, 0);
+      format = var ? var->data.image.format : PIPE_FORMAT_NONE;
+   }
+   return format == PIPE_FORMAT_NONE || format == PIPE_FORMAT_R10G10B10A2_UNORM ||
+          format == PIPE_FORMAT_B10G10R10A2_UNORM;
+}
+
+/* Whether instr is a float32 texture or image load that may read A2. */
+static inline bool
+is_a2_alpha_load(nir_instr *instr)
+{
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      switch (tex->op) {
+      case nir_texop_tex:
+      case nir_texop_txb:
+      case nir_texop_txl:
+      case nir_texop_txd:
+      case nir_texop_txf:
+      case nir_texop_txf_ms:
+      case nir_texop_tg4:
+         break;
+      default:
+         return false;
+      }
+
+      return tex->def.bit_size == 32 && !tex->is_shadow && nir_alu_type_get_base_type(tex->dest_type) == nir_type_float;
+   }
+
+   if (instr->type == nir_instr_type_intrinsic) {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      switch (intr->intrinsic) {
+      case nir_intrinsic_image_deref_load:
+      case nir_intrinsic_image_load:
+      case nir_intrinsic_bindless_image_load:
+         return intr->def.bit_size == 32 &&
+                nir_alu_type_get_base_type(nir_intrinsic_dest_type(intr)) == nir_type_float &&
+                is_a2_alpha_image_format(intr);
+      default:
+         return false;
+      }
+   }
+
+   return false;
+}
+
+/* Which component of the texels channel chan of a load result holds. */
+static inline unsigned
+a2_alpha_load_component(nir_instr *instr, unsigned chan)
+{
+   /* tg4 returns the same component of 4 texels in every channel. */
+   if (instr->type == nir_instr_type_tex && nir_instr_as_tex(instr)->op == nir_texop_tg4)
+      return nir_instr_as_tex(instr)->component;
+   return chan;
+}
+
+static inline bool
+is_a2_alpha_result(nir_scalar s)
+{
+   nir_instr *instr = nir_def_instr(s.def);
+   return s.comp < 4 && is_a2_alpha_load(instr) && a2_alpha_load_component(instr, s.comp) == 3;
+}
+
+/* Whether trunc(alpha * k) of what the TP returns differs from that of the
+ * correct value, for a texel with an alpha of 1/3 or 2/3. An fsat between the
+ * multiply and the truncation is ignored, it can't make equal values differ.
+ */
+static inline bool
+a2_alpha_error_matters(nir_op op, float k)
+{
+   for (unsigned thirds = 1; thirds <= 2; thirds++) {
+      float hw = k * (thirds * A2_ALPHA_HW_THIRD);
+      double exact = (double) k * thirds / 3.0;
+      if (op == nir_op_ffloor ? floorf(hw) != floor(exact) : truncf(hw) != trunc(exact))
+         return true;
+   }
+
+   return false;
+}
+
+/* Whether the load returns unfiltered texels, whose alpha can only be 0, 1/3,
+ * 2/3 or 1.
+ */
+static inline bool
+is_a2_alpha_load_unfiltered(nir_instr *instr)
+{
+   if (instr->type != nir_instr_type_tex)
+      return true;
+
+   nir_texop op = nir_instr_as_tex(instr)->op;
+   return op == nir_texop_txf || op == nir_texop_txf_ms || op == nir_texop_tg4;
+}
+
+static inline bool
+is_a2_alpha_cmp(nir_op op)
+{
+   return op == nir_op_flt || op == nir_op_fge || op == nir_op_feq || op == nir_op_fneu;
+}
+
+/* Whether comparing what the TP returns with t gives a different result than
+ * comparing the correct value, for a texel with an alpha of 1/3 or 2/3. The
+ * alpha is the source alpha_src of the comparison, like a > 0.666666.
+ */
+static inline bool
+a2_alpha_cmp_error_matters(nir_op op, unsigned alpha_src, float t)
+{
+   for (unsigned thirds = 1; thirds <= 2; thirds++) {
+      float v[2] = { thirds * A2_ALPHA_HW_THIRD, thirds / 3.0f };
+      bool res[2];
+      for (unsigned i = 0; i < 2; i++) {
+         float a = alpha_src == 0 ? v[i] : t;
+         float b = alpha_src == 0 ? t : v[i];
+         switch (op) {
+         case nir_op_flt:
+            res[i] = a < b;
+            break;
+         case nir_op_fge:
+            res[i] = a >= b;
+            break;
+         case nir_op_feq:
+            res[i] = a == b;
+            break;
+         default:
+            res[i] = a != b;
+            break;
+         }
+      }
+      if (res[0] != res[1])
+         return true;
+   }
+
+   return false;
+}
+
+static inline bool
+is_a2_alpha_trunc(nir_op op)
+{
+   return op == nir_op_ffloor || op == nir_op_ftrunc || op == nir_op_f2i32 || op == nir_op_f2u32;
+}
+
+/* Whether def is only converted to an integer, possibly after fsat. Other
+ * uses, like fract(a * 16), see the error scaled by the constant.
+ */
+static inline bool
+is_a2_alpha_only_truncated(nir_def *def)
+{
+   nir_foreach_use_including_if (src, def) {
+      if (nir_src_is_if(src) || nir_src_use_instr(src)->type != nir_instr_type_alu)
+         return false;
+
+      nir_alu_instr *alu = nir_instr_as_alu(nir_src_use_instr(src));
+      if (alu->op == nir_op_fsat || alu->op == nir_op_mov) {
+         if (!is_a2_alpha_only_truncated(&alu->def))
+            return false;
+      } else if (!is_a2_alpha_trunc(alu->op)) {
+         return false;
+      }
+   }
+
+   return true;
+}
+
+/* Match cmp(result, const) or trunc(fsat?(fmul(result, const))), result is
+ * a float32 channel of a texture or image load.
+ */
+static inline bool
+match_a2_alpha_shape(nir_alu_instr *alu, struct a2_alpha_site *site, float *k)
+{
+   if (alu->def.num_components != 1)
+      return false;
+
+   nir_scalar s;
+   if (is_a2_alpha_cmp(alu->op)) {
+      if (alu->src[0].src.ssa->bit_size != 32)
+         return false;
+      s = nir_get_scalar(&alu->def, 0);
+   } else if (is_a2_alpha_trunc(alu->op)) {
+      s = nir_scalar_chase_movs(nir_scalar_chase_alu_src(nir_get_scalar(&alu->def, 0), 0));
+      if (nir_scalar_is_alu(s) && nir_scalar_alu_op(s) == nir_op_fsat)
+         s = nir_scalar_chase_movs(nir_scalar_chase_alu_src(s, 0));
+
+      if (!nir_scalar_is_alu(s) || nir_scalar_alu_op(s) != nir_op_fmul || s.def->num_components != 1)
+         return false;
+   } else {
+      return false;
+   }
+
+   for (unsigned i = 0; i < 2; i++) {
+      nir_scalar result = nir_scalar_chase_movs(nir_scalar_chase_alu_src(s, i));
+      nir_scalar other = nir_scalar_chase_movs(nir_scalar_chase_alu_src(s, 1 - i));
+      if (nir_scalar_is_const(other) && result.comp < 4 && is_a2_alpha_load(nir_def_instr(result.def))) {
+         *site = (struct a2_alpha_site) {
+            .alu = nir_scalar_as_alu(s),
+            .src = i,
+            .result = result,
+         };
+         *k = nir_scalar_as_float(other);
+         return true;
+      }
+   }
+
+   return false;
+}
+
+/* Like match_a2_alpha_shape(), but the result has to be the alpha channel.
+ *
+ * Comparisons are only fixed when the error changes them for an alpha of 1/3
+ * or 2/3. For unfiltered texels whose product is only truncated, the error
+ * also has to change the result. A filtered alpha can be any value, so the
+ * error can change the truncated result for any constant.
+ */
+static inline bool
+match_a2_alpha_site(nir_alu_instr *alu, struct a2_alpha_site *site)
+{
+   float k;
+   if (!match_a2_alpha_shape(alu, site, &k) || !is_a2_alpha_result(site->result))
+      return false;
+
+   if (is_a2_alpha_cmp(alu->op))
+      return a2_alpha_cmp_error_matters(alu->op, site->src, k);
+
+   return !is_a2_alpha_load_unfiltered(nir_def_instr(site->result.def)) ||
+          !is_a2_alpha_only_truncated(&site->alu->def) || a2_alpha_error_matters(alu->op, k);
+}
+
+static inline bool
+tu_nir_has_a2_alpha_sites(nir_shader *shader)
+{
+   nir_foreach_function_impl (impl, shader) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            struct a2_alpha_site site;
+            if (instr->type == nir_instr_type_alu && match_a2_alpha_site(nir_instr_as_alu(instr), &site))
+               return true;
+         }
+      }
+   }
+
+   return false;
+}
+
+/* The bindless resource of a lowered A2 load, or NULL. */
+static inline nir_intrinsic_instr *
+get_a2_alpha_bindless(nir_instr *instr)
+{
+   nir_def *handle;
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      int handle_idx = nir_tex_instr_src_index(tex, nir_tex_src_texture_handle);
+      if (handle_idx < 0)
+         return NULL;
+      handle = tex->src[handle_idx].src.ssa;
+   } else {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      if (intr->intrinsic != nir_intrinsic_bindless_image_load)
+         return NULL;
+      handle = intr->src[0].ssa;
+   }
+
+   if (!nir_def_is_intrinsic(handle) || nir_def_as_intrinsic(handle)->intrinsic != nir_intrinsic_bindless_resource_ir3)
+      return NULL;
+
+   return nir_def_as_intrinsic(handle);
+}
+
+struct lower_a2_alpha_state {
+   struct tu_shader *shader;
+   bool load_shader_consts_via_preamble;
+   const struct ir3_const_allocations *const_allocs;
+};
+
+/* Load the A2 channel mask of the descriptor, see FDL6_A2_MASK_DWORD. */
+static inline nir_def *
+build_a2_mask(nir_builder *b, nir_intrinsic_instr *bindless, const struct lower_a2_alpha_state *state)
+{
+   nir_def *set_base =
+      tu_build_desc_set_base(b, bindless, state->shader, state->load_shader_consts_via_preamble, state->const_allocs);
+   nir_def *mask_offset =
+      nir_iadd_imm(b, nir_imul_imm(b, bindless->src[0].ssa, FDL6_TEX_CONST_DWORDS * 4), FDL6_A2_MASK_DWORD * 4);
+   return nir_load_global_offset(
+      b, 1, 32, set_base, mask_offset,
+      .access = static_cast<enum gl_access_qualifier>(ACCESS_NON_WRITEABLE | ACCESS_CAN_REORDER | ACCESS_CAN_SPECULATE),
+      .align_mul = 4, .align_offset = 0);
+}
+
+static inline bool
+lower_a2_alpha(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   auto state = static_cast<const lower_a2_alpha_state *>(data);
+
+   struct a2_alpha_site site;
+   if (!match_a2_alpha_site(alu, &site))
+      return false;
+
+   nir_intrinsic_instr *bindless = get_a2_alpha_bindless(nir_def_instr(site.result.def));
+   if (!bindless)
+      return false;
+
+   b->cursor = nir_before_instr(&site.alu->instr);
+
+   nir_def *mask = build_a2_mask(b, bindless, state);
+   nir_def *v = nir_channel(b, site.result.def, site.result.comp);
+   nir_def *is_a2 = nir_i2b(b, nir_iand_imm(b, mask, 1u << 3));
+   nir_def *fixed = nir_fmin_imm(b, nir_fmul_imm(b, v, 4096.0 / 4095.0), 1.0);
+
+   nir_src_rewrite(&site.alu->src[site.src].src, nir_bcsel(b, is_a2, fixed, v));
+   site.alu->src[site.src].swizzle[0] = 0;
+   return true;
+}
+
+static inline bool
+tu_nir_lower_a2_alpha(nir_shader *nir,
+                      struct tu_shader *shader,
+                      bool load_shader_consts_via_preamble,
+                      const struct ir3_const_allocations *const_allocs)
+{
+   struct lower_a2_alpha_state state = {
+      .shader = shader,
+      .load_shader_consts_via_preamble = load_shader_consts_via_preamble,
+      .const_allocs = const_allocs,
+   };
+   return nir_shader_alu_pass(nir, lower_a2_alpha, nir_metadata_control_flow, &state);
+}
+
+#endif /* TU_NIR_A2_ALPHA_WORKAROUND_H */
